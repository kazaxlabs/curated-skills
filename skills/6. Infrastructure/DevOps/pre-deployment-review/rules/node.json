  {
    "id": "node.lockfile.present",
    "title": "A lockfile is committed",
    "severity": "block",
    "applies_when": { "all": ["runtime=node"] },
    "check": { "type": "facet", "facet": "package_manager", "expect": "present" },
    "remediation": "Commit package-lock.json / pnpm-lock.yaml / yarn.lock and install with the frozen-lockfile command in CI.",
    "sources": [ { "title": "OpenSSF Scorecard — Pinned-Dependencies", "url": "https://github.com/ossf/scorecard/blob/main/docs/checks.md", "tier": "standards", "fetched": "2026-10-27", "status": 200 } ],
    "skills": ["nodejs-best-practices"]
  },
  {
