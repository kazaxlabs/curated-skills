{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazaxlabs/curated-skills/schemas/agent-config.schema.json",
  "title": "Curated_Skills agent configuration",
  "description": "Local schema for agent.config.json. This is not an industry standard: the AGENTS.md specification defines no machine-readable companion config. This schema exists so the file is validated by scripts/validate_agent_config.py rather than being an inert document.",
  "type": "object",
  "required": ["version", "name", "governing_document", "protocols", "manifest"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative path to this schema. Must be local: the AGENTS.md specification defines no config schema, so any remote schema URL here is fabricated authority."
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantic version of this configuration."
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "owner": { "type": "string" },
    "governing_document": {
      "type": "object",
      "required": ["path", "max_characters", "reason"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string" },
        "max_characters": {
          "type": "integer",
          "minimum": 1,
          "description": "Hard cap enforced by the validator. 12000 is Antigravity's documented per-rules-file limit."
        },
        "reason": { "type": "string" },
        "source": { "type": "string", "format": "uri" },
        "bridges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "mechanism", "must_contain"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "mechanism": { "type": "string", "enum": ["import", "symlink", "native"] },
              "must_contain": { "type": "string" }
            }
          }
        }
      }
    },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "canonical_file_check": { "type": "boolean" },
            "state_recovery": { "type": "boolean" },
            "context_budgeting": { "type": "boolean" }
          }
        },
        "evidence_gate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "require_load_bearing_registration": { "type": "boolean" },
            "citation_must_resolve_200": {
              "type": "boolean",
              "description": "A claim is not 'sourced' until its URL was fetched this session and returned 200."
            },
            "source_tiers": {
              "type": "array",
              "items": { "type": "string" },
              "minItems": 1
            },
            "self_authored_tests_are_not_evidence": { "type": "boolean" },
            "mcp_decision_record": { "type": "boolean" }
          }
        },
        "pipeline": {
          "type": "object",
          "required": ["skill", "stages", "ordering"],
          "additionalProperties": false,
          "properties": {
            "skill": { "type": "string" },
            "ordering": {
              "type": "string",
              "enum": ["default_path_with_reentry", "strict"],
              "description": "'strict' is discouraged: static one-shot plans propagate errors forward."
            },
            "stages": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["id", "name", "skills", "verdict"],
                "additionalProperties": false,
                "properties": {
                  "id": { "type": "integer", "minimum": 1 },
                  "name": { "type": "string" },
                  "skills": { "type": "array", "items": { "type": "string" } },
                  "verdict": {
                    "type": "string",
                    "enum": ["machine", "review"],
                    "description": "'machine' means the stage terminates in an exit code, linter result, diff or HTTP status. 'review' means prose, and does not count as verification."
                  },
                  "verdict_note": { "type": "string" },
                  "skippable_when": { "type": "string" }
                }
              }
            }
          }
        },
        "plain_english_summary": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" },
            "marker": { "type": "string" },
            "sentence_range": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 },
              "minItems": 2,
              "maxItems": 2
            },
            "session_override_command": { "type": "string" }
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "description": "Every entry is resolved against the filesystem by the validator. Categories are separate because a skill, an MCP server and a slash command are different kinds of thing.",
      "additionalProperties": false,
      "properties": {
        "skills": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Resolved under skills/**/<name>/SKILL.md"
        },
        "mcp_servers": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Not skills. Provided by the harness, not this repository."
        },
        "commands": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Slash commands. Resolved under ~/.claude/commands/<name>.md; absence is a warning, not an error, since they are user-scoped."
        }
      }
    }
  }
}
